# Caddyfile for a Caddy binary running on the host (no Docker).
#
# This is the default deployment path for horizon.european-commission-europa.eu: docker compose
# publishes the app on 127.0.0.1:25343 and this config terminates TLS and
# proxies to it.
#
# Install:
#   sudo cp infra/Caddyfile.host /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Requirements:
#   - DNS A/AAAA records for horizon.european-commission-europa.eu (and www) pointing at this host
#   - Ports 80 and 443 free (do NOT also run the optional `caddy` compose
#     service, it binds the same ports)

# Optional: uncomment and set a real address to receive Let's Encrypt expiry
# notices. An `email` directive with an empty value stops Caddy from starting.
# {
# 	email admin@horizon.european-commission-europa.eu
# }

www.horizon.european-commission-europa.eu {
	redir https://horizon.european-commission-europa.eu{uri} permanent
}

horizon.european-commission-europa.eu {
	encode gzip zstd

	reverse_proxy 127.0.0.1:25343 {
		header_up X-Forwarded-Host {host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	log {
		output file /var/log/caddy/horizon.european-commission-europa.eu.log
		format console
	}
}
