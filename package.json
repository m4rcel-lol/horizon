{
  "name": "horizon",
  "version": "0.1.0",
  "private": true,
  "description": "Community-first, self-hostable social platform",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @horizon/database generate",
    "db:migrate": "pnpm --filter @horizon/database migrate",
    "db:migrate:dev": "pnpm --filter @horizon/database migrate:dev",
    "db:seed": "pnpm --filter @horizon/database seed",
    "db:studio": "pnpm --filter @horizon/database studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
