# =============================================================================
# Horizon Environment Configuration
# Copy to .env and fill in values. Never commit .env
# =============================================================================

# -----------------------------------------------------------------------------
# Core (required)
# -----------------------------------------------------------------------------
NODE_ENV=production
INSTANCE_URL=https://tweeting.shop
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Generate with: openssl rand -hex 32
CSRF_SECRET=change-me-to-another-long-random-string

# -----------------------------------------------------------------------------
# Database (PostgreSQL) — required
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://horizon:horizon@postgres:5432/horizon?schema=public
POSTGRES_USER=horizon
POSTGRES_PASSWORD=horizon
POSTGRES_DB=horizon

# -----------------------------------------------------------------------------
# Redis — required
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Object Storage (S3-compatible) — OPTIONAL
#
# You can leave these unset and configure storage entirely in the admin panel:
#   Admin → Instance → Storage
#
# If set here, environment values take precedence over admin settings.
# Recommended for production secrets; admin UI is convenient for self-host setup.
# -----------------------------------------------------------------------------
# STORAGE_ENDPOINT=http://minio:9000
# STORAGE_REGION=us-east-1
# STORAGE_BUCKET=horizon
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin
# STORAGE_FORCE_PATH_STYLE=true
# STORAGE_PUBLIC_URL=http://localhost:9000/horizon

# Default Docker Compose MinIO (uncomment / keep for local docker without admin setup):
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=horizon
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
# Uploaded media is served through the site's own /media route (proxied to
# MinIO by the web container), so MinIO itself stays off the public internet.
STORAGE_PUBLIC_URL=https://tweeting.shop/media

# -----------------------------------------------------------------------------
# SMTP / Email — OPTIONAL
#
# Leave unset and configure in the admin panel:
#   Admin → Instance → Email
#
# Environment values override admin settings when present.
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Horizon <noreply@horizon.example.com>"

# -----------------------------------------------------------------------------
# Feature Flags (infrastructure level)
# -----------------------------------------------------------------------------
FEDERATION_ENABLED=false
MAINTENANCE_MODE=false

# -----------------------------------------------------------------------------
# HTTP / reverse proxy
#
# Docker Compose publishes the whole site (SPA + /api + /media) on a single
# port. A TLS reverse proxy in front of it serves https://tweeting.shop.
#
# By default that proxy is the Caddy binary on the host — see
# infra/Caddyfile.host. The port is bound to loopback so only the host's proxy
# can reach it; set HTTP_BIND_ADDR=0.0.0.0 if the proxy runs on another machine
# (and firewall the port accordingly).
# -----------------------------------------------------------------------------
HTTP_PORT=25343
HTTP_BIND_ADDR=127.0.0.1

# MinIO API/console bind address. Keep on loopback in production.
MINIO_BIND_ADDR=127.0.0.1

# -----------------------------------------------------------------------------
# Caddy / TLS — only for the OPTIONAL containerized edge proxy
#
#   docker compose --profile edge up -d
#
# Leave these alone when Caddy runs as a binary on the host; that setup takes
# its domain and ACME email from infra/Caddyfile.host instead.
# -----------------------------------------------------------------------------
CADDY_DOMAIN=tweeting.shop
# ACME_EMAIL=admin@tweeting.shop
